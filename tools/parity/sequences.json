  {
    "id": "defeat_sector_1",
    "description": "Press PLAY MISSION, no input for 5 s, force the out-of-scrap failure, retry from the defeat modal",
    "steps": [
      { "op": "boot" },
      { "op": "click", "target": "btn-home-play" },
      { "op": "advance", "ms": 5000 },
      { "op": "call", "method": "handleLevelFailure", "args": [] },
      { "op": "advance", "ms": 1000 },
      { "op": "click", "target": "btn-defeat-retry" },
      { "op": "advance", "ms": 1500 }
    ]
  },
  {
    "id": "shop_purchase_and_equip",
    "description": "Buy and auto-equip a ring, fail to buy a hat, switch tabs, wear the starter ring again",
    "steps": [
      { "op": "boot" },
      { "op": "setProfile", "path": "credits", "value": 1000 },
      { "op": "click", "target": "btn-open-shop-page" },
      { "op": "advance", "ms": 400 },
      {
        "op": "clickSelector",
        "selector": ".btn-buy-item[data-id=ring_duckie]"
      },
      { "op": "advance", "ms": 1000 },
      { "op": "clickSelector", "selector": ".tab-btn[data-tab=singularities]" },
      { "op": "advance", "ms": 200 },
      {
        "op": "clickSelector",
        "selector": ".btn-buy-item[data-id=singularity_strawberry]"
      },
      { "op": "advance", "ms": 1000 },
      { "op": "clickSelector", "selector": ".tab-btn[data-tab=rings]" },
      { "op": "advance", "ms": 200 },
      {
        "op": "clickSelector",
        "selector": ".btn-equip-item[data-id=ring_donut]"
      },
      { "op": "advance", "ms": 1000 },
      { "op": "click", "target": "btn-back-shop" },
      { "op": "advance", "ms": 400 }
    ]
  },
  {
    "id": "daily_gift_claim",
    "description": "Claim the shop stipend, then the daily master bonus after clearing all shifts",
    "steps": [
      { "op": "boot" },
      { "op": "click", "target": "btn-open-shop-page" },
      { "op": "advance", "ms": 400 },
      { "op": "click", "target": "btn-claim-daily-gift" },
      { "op": "advance", "ms": 1500 },
      { "op": "click", "target": "btn-back-shop" },
      { "op": "advance", "ms": 400 },
      {
        "op": "setProfile",
        "path": "lastDailyShiftDate",
        "value": "2026-10-01"
      },
      {
        "op": "setProfile",
        "path": "completedDailyTiers",
        "value": ["bronze", "silver", "gold"]
      },
      { "op": "click", "target": "btn-open-daily-shift" },
      { "op": "advance", "ms": 400 },
      { "op": "click", "target": "btn-claim-master-bonus" },
      { "op": "advance", "ms": 1500 }
    ]
  },
  {
    "id": "settings_toggles",
    "description": "Settings: toggle haptics and sound, drag both sliders, haptic buzz only while enabled",
    "steps": [
      { "op": "boot" },
      { "op": "click", "target": "btn-home-settings" },
      { "op": "advance", "ms": 240 },
      { "op": "call", "method": "triggerHaptic", "args": [30] },
      { "op": "click", "target": "settings-haptics-toggle" },
      { "op": "advance", "ms": 300 },
      { "op": "call", "method": "triggerHaptic", "args": [30] },
      { "op": "click", "target": "settings-haptics-toggle" },
      { "op": "advance", "ms": 300 },
      { "op": "call", "method": "triggerHaptic", "args": [45] },
      { "op": "click", "target": "settings-sfx-slider", "fx": 0.3 },
      { "op": "advance", "ms": 100 },
      { "op": "click", "target": "settings-ambience-slider", "fx": 0.8 },
      { "op": "advance", "ms": 100 },
      { "op": "click", "target": "settings-sound-toggle" },
      { "op": "advance", "ms": 300 },
      { "op": "click", "target": "settings-sound-toggle" },
      { "op": "advance", "ms": 300 },
      { "op": "click", "target": "btn-back-settings" },
      { "op": "advance", "ms": 400 }
    ]
  },
  {
    "id": "pause_resume_exit",
    "description": "Play, pause, toggle sound twice, resume, pause again and return home",
    "steps": [
      { "op": "boot" },
      { "op": "click", "target": "btn-home-play" },
      { "op": "advance", "ms": 500 },
      { "op": "click", "target": "btn-game-pause" },
      { "op": "advance", "ms": 300 },
      { "op": "click", "target": "btn-pause-sound" },
      { "op": "advance", "ms": 100 },
      { "op": "click", "target": "btn-pause-sound" },
      { "op": "advance", "ms": 100 },
      { "op": "click", "target": "btn-pause-resume" },
      { "op": "advance", "ms": 600 },
      { "op": "click", "target": "btn-game-pause" },
      { "op": "advance", "ms": 300 },
      { "op": "click", "target": "btn-pause-home" },
      { "op": "advance", "ms": 600 }
    ]
  }
