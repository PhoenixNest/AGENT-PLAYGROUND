{
  "version": 1,
  "symbols": ["NotoSansSymbols2-Regular", "NotoSansSymbols-Regular"],
  "roles": {
    "fredoka": [
      { "weight": 400, "file": "Fredoka-400" },
      { "weight": 600, "file": "Fredoka-600" },
      { "weight": 700, "file": "Fredoka-700" }
    ],
    "nunito": [
      { "weight": 700, "file": "Nunito-700" },
      { "weight": 800, "file": "Nunito-800" },
      { "weight": 900, "file": "Nunito-900" }
    ]
  },
  "groups": {
    "latin": {
      "display": "fredoka",
      "body": "nunito",
      "fallback": ["@symbols"]
    },
    "latin-vi": {
      "display": "fredoka",
      "body": "nunito",
      "fallback": ["@symbols"]
    },
    "latin-uz": {
      "note": "Uzbek only. prefix is U+02BB with a narrow advance, placed ahead of Fredoka and Nunito. Display 600/700 follow the Fredoka face. Body uses 700/800/900. Other Latin languages do not use this group.",
      "display": "fredoka",
      "body": "nunito",
      "prefix": [
        { "weight": 600, "file": "Nunito-uz-patch-600" },
        { "weight": 700, "file": "Nunito-uz-patch-700" },
        { "weight": 800, "file": "Nunito-uz-patch-800" },
        { "weight": 900, "file": "Nunito-uz-patch-900" }
      ],
      "fallback": ["@symbols"]
    },
    "cjk-sc": {
      "note": "ZCOOL KuaiLe has one master (OS/2 400). It is a display drawing. Every CSS weight uses this file. No heavier master exists.",
      "display": [{ "weight": 400, "file": "ZCOOLKuaiLe-sc" }],
      "body": [{ "weight": 400, "file": "ZCOOLKuaiLe-sc" }],
      "fallback": ["@nunito", "@symbols"]
    },
    "cjk-tc": {
      "note": "Huninn has one master (OS/2 400), a regular rounded gothic. Every CSS weight uses this file. No heavier master exists.",
      "display": [{ "weight": 400, "file": "Huninn-tc" }],
      "body": [{ "weight": 400, "file": "Huninn-tc" }],
      "fallback": ["@nunito", "@symbols"]
    },
    "cjk-jp": {
      "note": "M PLUS Rounded 1c Bold (700). CSS 400 and CSS 900 both resolve to this file. Black (900) is not shipped: the same face paints body text, and Fredoka already maps 800 and 900 to 700.",
      "display": [{ "weight": 700, "file": "MPLUSRounded1c-700" }],
      "body": [{ "weight": 700, "file": "MPLUSRounded1c-700" }],
      "fallback": ["@nunito", "@symbols"]
    },
    "cjk-kr": {
      "note": "Jua has one master (OS/2 400). It is a display drawing. Every CSS weight uses this file. The source has no U+0060; Nunito in the chain has it.",
      "display": [{ "weight": 400, "file": "Jua-kr" }],
      "body": [{ "weight": 400, "file": "Jua-kr" }],
      "fallback": ["@nunito", "@symbols"]
    },
    "devanagari": {
      "display": [{ "weight": 700, "file": "Baloo2-700" }],
      "body": [{ "weight": 700, "file": "Baloo2-700" }],
      "fallback": ["@nunito", "@symbols"]
    },
    "khmer": {
      "display": [{ "weight": 700, "file": "KantumruyPro-700" }],
      "body": [{ "weight": 700, "file": "KantumruyPro-700" }],
      "fallback": ["@nunito", "@symbols"]
    },
    "arabic": {
      "display": [{ "weight": 700, "file": "Cairo-700" }],
      "body": [{ "weight": 700, "file": "Cairo-700" }],
      "fallback": ["@nunito", "@symbols"]
    }
  }
}
